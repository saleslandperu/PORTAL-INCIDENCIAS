# Copie este archivo a .env y complete los valores fuera del repositorio.
# No use el prefijo VITE_ para estos secretos.

PORT=3001
SESSION_SECRET=

# Si se define, se crea o actualiza el usuario administrador inicial (hash bcrypt en SQLite).
PORTAL_BOOTSTRAP_USERNAME=admin.ti
PORTAL_BOOTSTRAP_PASSWORD=
PORTAL_BOOTSTRAP_EMAIL=admin.ti@localhost

# true solo en desarrollo: replica usuarios de demostración con la clave de arranque.
ALLOW_DEMO_USER_SEED=false

# GLPI 11 — OAuth2 password grant (documentación: POST /api.php/token, scope api)
GLPI_BASE_URL=
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_SCOPE=api
GLPI_TICKET_LIMIT=50
# Tope de tickets que se traen paginando para el dashboard
GLPI_TICKET_MAX=5000

# MySQL de GLPI (solo lectura) para leer el centro de costo de cada ticket
GLPI_DB_HOST=
GLPI_DB_PORT=3306
GLPI_DB_NAME=
GLPI_DB_USER=
GLPI_DB_PASS=
